# Papers-SR-Assistant 환경 변수 예시 / example env vars
# 복사해서 사용: cp .env.example .env.local  (실제 키는 절대 커밋 금지 / never commit real secrets)

# Gemini API 키 — 설정 시 AI 챗·요약이 Gemini 를 사용 (미설정 시 로컬 Ollama 자동 폴백)
# 런타임 주입도 가능: 브라우저 localStorage "psra:geminiKey" (로컬 전용)
VITE_GEMINI_API_KEY=

# Ollama 폴백 모델 지정 (미설정 시 설치된 첫 모델 자동 선택)
VITE_OLLAMA_MODEL=
